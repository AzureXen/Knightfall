<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefabs/UI%20Graphics/ShopUI.uss?fileID=7433441132597879392&amp;guid=4096dc0e24b72194a84c876a08e6ecf4&amp;type=3#ShopUI"/>
    <ui:VisualElement name="backdrop_panel" class="backdrop_panel">
        <ui:VisualElement name="player_info_display" class="player_info_display" style="background-color: rgba(243, 195, 77, 0.325);">
            <ui:VisualElement name="player_gold" class="player_gold" style="background-color: rgba(255, 0, 0, 0);">
                <ui:Image source="project://database/Assets/Art/NhatAsset/2drpgAssets/Sprites/UI/Gold%20Coin%20Sprite%20Sheet.png?fileID=260386565&amp;guid=cb72e768b48297d478695f82b2c7a327&amp;type=3#Gold Coin Sprite Sheet_0 spaceless" name="gold_icon" style="width: 50%; height: 60%; min-width: 50px; max-width: none;"/>
                <ui:Label text="300" name="gold_value" style="color: rgb(236, 193, 30); -unity-text-align: middle-center; -unity-font-style: normal; text-overflow: ellipsis; width: 50%; height: 50%; min-height: 50px; max-height: 50px; flex-wrap: nowrap; font-size: 54px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="player_upgrade_list" style="flex-grow: 1; background-color: rgba(110, 80, 247, 0.612); width: 100%; justify-content: center; flex-direction: row; align-items: center; align-self: auto; align-content: flex-start; flex-wrap: nowrap; flex-basis: auto;"/>
        <ui:VisualElement name="additional_options" style="flex-grow: 0; background-color: rgba(247, 80, 115, 0.612); width: 100%; justify-content: center; flex-direction: row; align-items: center; align-self: auto; align-content: flex-start; flex-wrap: nowrap; flex-basis: auto; height: 15%;"/>
    </ui:VisualElement>
