<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefabs/UI%20Graphics/ShopUI.uss?fileID=7433441132597879392&amp;guid=4096dc0e24b72194a84c876a08e6ecf4&amp;type=3#ShopUI"/>
    <ui:VisualElement name="backdrop_panel" class="backdrop_panel" style="padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%;">
        <ui:VisualElement name="upper_section" class="player_info_display" style="background-color: rgba(243, 195, 77, 0); height: 9%; flex-shrink: 0; flex-direction: row;">
            <ui:VisualElement name="left_upper" style="flex-grow: 1; width: 50%; height: 100%;">
                <ui:VisualElement name="player_gold" class="player_gold" style="background-color: rgba(255, 0, 0, 0);">
                    <ui:Image source="project://database/Assets/Art/NhatAsset/2drpgAssets/Sprites/UI/Gold%20Coin%20Sprite%20Sheet.png?fileID=260386565&amp;guid=cb72e768b48297d478695f82b2c7a327&amp;type=3#Gold Coin Sprite Sheet_0 spaceless" name="gold_icon" style="width: 19%; height: 100%; min-width: 50px; max-width: none;"/>
                    <ui:Label text="300" name="gold_value" style="color: rgb(236, 193, 30); -unity-text-align: middle-center; -unity-font-style: normal; text-overflow: ellipsis; width: 50%; height: 100%; min-height: auto; max-height: none; flex-wrap: nowrap; font-size: 42px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="right_upper" style="flex-grow: 1; width: 50%; height: 100%; flex-direction: row-reverse;">
                <ui:VisualElement name="close_btn" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/Kenney&apos;s%20Assets/kenney_ui-pack/PNG/Grey/Double/icon_outline_cross.png?fileID=2800000&amp;guid=9f0e2bafa22248846b4d791cf9643c06&amp;type=3#icon_outline_cross&quot;); width: 100px; margin-top: 0%; margin-right: 2%; margin-bottom: 0%; margin-left: 2%; transition-duration: 0.2s; transition-timing-function: ease-in-out-bounce;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="player_upgrade_list" style="flex-grow: 1; background-color: rgba(110, 80, 247, 0); width: 100%; justify-content: center; flex-direction: row; align-items: center; align-self: auto; align-content: flex-start; flex-wrap: nowrap; flex-basis: auto;"/>
        <ui:VisualElement name="additional_options" style="flex-grow: 0; background-color: rgba(247, 80, 115, 0); width: 100%; justify-content: center; flex-direction: row; align-items: center; align-self: auto; align-content: flex-start; flex-wrap: nowrap; flex-basis: auto; height: 9%; flex-shrink: 0;"/>
    </ui:VisualElement>
</ui:UXML>
